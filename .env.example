# Sao chép thành `.env` (đã được .gitignore). KHÔNG commit khóa thật, KHÔNG dán khóa vào chat.

# ---- Facade: LLM (bỏ trống 3 biến LLM_* = chế độ mock, không gọi mạng) ----
# Mặc định đề xuất: Groq free (không cần thẻ; ~30 RPM; hạn mức theo model, xem https://console.groq.com/settings/limits)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
# Nhà cung cấp khác dùng cùng giao thức OpenAI: chỉ đổi 3 dòng trên, ví dụ
#   Cerebras   https://api.cerebras.ai/v1
#   OpenRouter https://openrouter.ai/api/v1
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai   (free tier hay bị cắt hạn mức)
LLM_MAX_RPM=20                 # dưới hạn mức RPM của nhà cung cấp
LLM_DAILY_TOKEN_BUDGET=0       # ước lượng token/ngày; 0 = không giới hạn (Groq free llama-3.3-70b ~100000)
LLM_FALLBACK=error             # 'mock' = LLM lỗi/hết hạn mức thì dùng câu trả lời theo kịch bản (cho ngày demo)
LLM_TIMEOUT_MS=20000

# ---- Facade: lưu trữ & mạng ----
FACADE_DB=./data/facade.db     # bỏ trống = lưu trong bộ nhớ (mất khi khởi động lại)
CORS_ORIGIN=*                  # production: origin của Host, ví dụ https://app.example.com
FACADE_DEV=0                   # 1 = bật /dev/seed, /error, /timeout (chỉ phát triển)

# ---- Docker Compose: URL công khai mà TRÌNH DUYỆT dùng để tới từng thành phần ----
FACADE_PUBLIC_URL=http://localhost:4000
REMOTE_CHAT_URL=http://localhost:3001/remoteEntry.js
REMOTE_PROGRESS_URL=http://localhost:3002/remoteEntry.js
REMOTE_PERSONALIZATION_URL=http://localhost:3003/remoteEntry.js
