{
    "name":  "ai-mfe-mobile",
    "version":  "0.1.0",
    "private":  true,
    "main":  "expo-router/entry",
    "scripts":  {
                    "start":  "expo start",
                    "typecheck":  "tsc --noEmit",
                    "test":  "jest",
                    "bundle":  "expo export --platform android --output-dir dist"
                },
    "dependencies":  {
                         "@react-native-async-storage/async-storage":  "2.2.0",
                         "expo":  "~57.0.28",
                         "expo-constants":  "~57.0.21",
                         "expo-linking":  "~57.0.12",
                         "expo-router":  "~57.0.26",
                         "expo-status-bar":  "~57.0.1",
                         "react":  "19.2.3",
                         "react-native":  "0.86.3",
                         "react-native-safe-area-context":  "~5.7.0",
                         "react-native-screens":  "~4.26.0",
                         "react-native-svg":  "15.15.4"
                     },
    "devDependencies":  {
                            "@react-native/jest-preset":  "^0.86.3",
                            "@testing-library/react-native":  "14.1.0",
                            "@types/react":  "~19.2.2",
                            "jest":  "~29.7.0",
                            "jest-expo":  "~57.0.6",
                            "react-test-renderer":  "^19.2.3",
                            "typescript":  "~5.9.3"
                        },
    "jest":  {
                 "preset":  "jest-expo",
                 "setupFilesAfterEnv":  [
                                            "\u003crootDir\u003e/jest.setup.js"
                                        ],
                 "moduleNameMapper":  {
                                          "^@app/shared-types$":  "\u003crootDir\u003e/../../packages/shared-types/src/index.ts",
                                          "^@app/facade-client$":  "\u003crootDir\u003e/../../packages/facade-client/src/index.ts",
                                          "^@app/chat-state$":  "\u003crootDir\u003e/../../packages/chat-state/src/index.ts",
                                          "^@app/chart-geometry$":  "\u003crootDir\u003e/../../packages/chart-geometry/src/index.ts",
                                          "^@babel/runtime/(.*)$":  "\u003crootDir\u003e/node_modules/@babel/runtime/$1",
                                          "^test-renderer/(.*)$":  "\u003crootDir\u003e/node_modules/react-test-renderer/$1",
                                          "^test-renderer$":  "\u003crootDir\u003e/__mocks__/test-renderer.js",
                                          "^test-renderer/(.*)":  "\u003crootDir\u003e/__mocks__/test-renderer.js"
                                      },
                 "testPathIgnorePatterns":  [
                                                "/node_modules/",
                                                "/dist/"
                                            ],
                 "testTimeout":  20000,
                 "testMatch":  [
                                   "**/__tests__/**/*.test.[jt]s?(x)"
                               ]
             }
}